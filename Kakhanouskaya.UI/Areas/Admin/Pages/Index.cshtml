@page
@model Kakhanouskaya.UI.Areas.Admin.Pages.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Кіраванне стравамі</h1>

<p>
    @* <a asp-page="/Admin/Create" class="btn btn-primary">
        <i class="fa-solid fa-plus"></i> Дадаць новую страву
    </a> *@
   @*  <a href="/Admin/Create" class="btn btn-primary">
        <i class="fa-solid fa-plus"></i> Дадаць новую страву
    </a> *@

    <a asp-area="Admin" asp-page="/Create" class="btn btn-primary">
        <i class="fa-solid fa-plus"></i> Дадаць новую страву
    </a>
</p>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.Dish[0].Name)</th>
            <th>@Html.DisplayNameFor(model => model.Dish[0].Description)</th>
            <th>@Html.DisplayNameFor(model => model.Dish[0].Price)</th>
            <th>@Html.DisplayNameFor(model => model.Dish[0].Image)</th>
            <th>@Html.DisplayNameFor(model => model.Dish[0].Category)</th>
            <th>Дзеянні</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Dish)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.Description)</td>
                <td>@Html.DisplayFor(modelItem => item.Price) руб.</td>
                <td>
                    @if (!string.IsNullOrEmpty(item.Image))
                    {
                        <img src="@item.Image" alt="@item.Name" style="width: 50px; height: 50px; object-fit: cover;" />
                    }
                    else
                    {
                        <span>Няма выявы</span>
                    }
                </td>
                <td>@Html.DisplayFor(modelItem => item.Category.Name)</td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                        <i class="fa-solid fa-pen-to-square"></i>
                    </a>
                    <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">
                        <i class="fa-solid fa-info"></i>
                    </a>
                    <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                        <i class="fa-regular fa-trash-can"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Пейджэр -->
@if (Model.TotalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            @if (Model.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-page="./Index" asp-route-pageNo="@(Model.CurrentPage - 1)">
                        <i class="fa-solid fa-chevron-left"></i> Папярэдняя
                    </a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link"><i class="fa-solid fa-chevron-left"></i> Папярэдняя</span>
                </li>
            }

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                @if (i == Model.CurrentPage)
                {
                    <li class="page-item active"><span class="page-link">@i</span></li>
                }
                else
                {
                    <li class="page-item"><a class="page-link" asp-page="./Index" asp-route-pageNo="@i">@i</a></li>
                }
            }

            @if (Model.CurrentPage < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" asp-page="./Index" asp-route-pageNo="@(Model.CurrentPage + 1)">
                        Наступная <i class="fa-solid fa-chevron-right"></i>
                    </a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">Наступная <i class="fa-solid fa-chevron-right"></i></span>
                </li>
            }
        </ul>
    </nav>
}