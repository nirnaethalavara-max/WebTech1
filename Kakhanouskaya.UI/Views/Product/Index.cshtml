@using Kakhanouskaya.DOMAIN.Entities
@using Kakhanouskaya.DOMAIN.Models
@model ListModel<Dish>

@{
    ViewData["Title"] = "Меню";

    // Атрымліваем катэгорыю з запыту
    string? category = Context.Request.Query["category"].ToString();

    // Калі катэгорыя прыйшла праз маршрут (для Задання 6)
    if (string.IsNullOrEmpty(category))
    {
        category = ViewContext.RouteData.Values["category"]?.ToString();
    }

    // Вылічаем папярэднюю старонку
    int prevPage = Model.CurrentPage == 1 ? 1 : Model.CurrentPage - 1;

    // Вылічаем наступную старонку
    int nextPage = Model.CurrentPage == Model.TotalPages ? Model.TotalPages : Model.CurrentPage + 1;

    // URL для вяртання (для кнопкі "У кошык")
    var request = ViewContext.HttpContext.Request;
    var returnUrl = request.Path + request.QueryString.ToUriComponent();
}

<h2 class="m-3 text-center">Наша меню</h2>

<!-- Фільтр па катэгорыях -->
<div class="row mb-4">
    <div class="col-12">
        <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                Катэгорыя: @ViewBag.CurrentCategory
            </button>
            <ul class="dropdown-menu">
                <li>
                    <a class="dropdown-item" asp-controller="Product" asp-action="Index" asp-route-category="">
                        Усе
                    </a>
                </li>
                @if (ViewBag.Categories != null)
                {
                    @foreach (var cat in ViewBag.Categories)
                    {
                        <li>
                            <a class="dropdown-item"
                               asp-controller="Product"
                               asp-action="Index"
                               asp-route-category="@cat.NormalizedName">
                                @cat.Name
                            </a>
                        </li>
                    }
                }
            </ul>
        </div>
    </div>
</div>

<!-- Спіс страў у выглядзе картак -->
@if (Model != null && Model.Items != null && Model.Items.Any())
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in Model.Items)  // ← ВАЖКА: Model.Items, а не проста Model
        {
            <partial name="_ProductItemPartial" model="item" />
        }
    </div>
}
else
{
    <div class="alert alert-warning text-center">
        @(ViewBag.Error ?? "Няма страў у гэтай катэгорыі")
    </div>
}

<!-- ========================================= -->
<!-- ЗАДАННЕ 2: КНОПКІ ПЕРАКЛЮЧЭННЯ СТАРОНАК -->
<!-- ========================================= -->
<!-- ЗАДАННЕ 3: Тэг-хелпер для пагінацыі (замяняе стары блок з 50 радкоў) -->
<pager current-page="@Model.CurrentPage"
       total-pages="@Model.TotalPages"
       category="@category"></pager>